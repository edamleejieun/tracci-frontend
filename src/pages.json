  "tabBar": {
    "color": "#9B958C",
    "selectedColor": "#4F7DFF",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home-inactive.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile-inactive.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "Tracci",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#FFFFFF"
  },
  "preloadRule": {
    "pages/index/index": {
      "network": "wifi",
      "packages": ["pages/trip"]
    },
    "pages/trip/detail": {
      "network": "all",
      "packages": ["pages/itinerary", "pages/co-editor"]
    },
    "pages/trip/create": {
      "network": "all",
      "packages": ["pages/itinerary"]
    },
    "pages/trip/members": {
      "network": "all",
      "packages": ["pages/co-editor"]
    }
  }
}
